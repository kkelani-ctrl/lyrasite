# Everything here is repo/build tooling, not part of the public site.
# Same syntax as .gitignore. Note: _headers is intentionally NOT listed —
# Workers parses it and applies the rules, and never serves it as an asset.
wrangler.toml
package.json
bun.lock
bun.lockb
package-lock.json
node_modules
.wrangler
.assetsignore
.gitignore
.backup

# Wrangler does NOT exclude these automatically for Workers static assets
# (unlike Pages), so they must be listed explicitly.
.git
.github
.vscode
.idea
.DS_Store
