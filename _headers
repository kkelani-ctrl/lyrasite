# Content-hashed under /assets/ — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  # Report-only on purpose: verify in DevTools, then rename the header to
  # Content-Security-Policy to enforce. 'unsafe-inline' is required until the
  # remaining inline Webflow init scripts are externalized or hashed.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' https://res.cloudinary.com; connect-src 'self' https://prod.spline.design https://cdn.jsdelivr.net https://www.gstatic.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'
